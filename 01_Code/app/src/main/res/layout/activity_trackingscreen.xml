<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/trackingBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:foregroundTint="#BC3333"
    tools:context=".Trackingscreen">

    <ImageView
        android:id="@+id/trackingPoint_E_1"
        android:layout_width="25dp"
        android:layout_height="25dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/ic_marker_cross_edge"
        />
    <ImageView
        android:id="@+id/trackingPoint_E_2"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:rotation="90"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/ic_marker_cross_edge" />
    <ImageView
        android:id="@+id/trackingPoint_E_3"
        android:layout_width="25dp"
        android:layout_height="25dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:rotation="180"
        app:srcCompat="@drawable/ic_marker_cross_edge" />
    <ImageView
        android:id="@+id/trackingPoint_E_4"
        android:layout_width="25dp"
        android:layout_height="25dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:rotation="270"
        app:srcCompat="@drawable/ic_marker_cross_edge" />

    <ImageView
        android:id="@+id/trackingPoint_3_3"
        android:layout_width="25dp"
        android:layout_height="25dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/guideline4"
        app:layout_constraintStart_toStartOf="@id/guideline3"
        app:srcCompat="@drawable/ic_marker_cross" />

    <ImageView
        android:id="@+id/trackingPoint_3_2"
        android:layout_width="25dp"
        android:layout_height="25dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="@id/guideline3"
        app:layout_constraintBottom_toTopOf="@id/guideline4"
        app:srcCompat="@drawable/ic_marker_cross" />

    <ImageView
        android:id="@+id/trackingPoint_3_4"
        android:layout_width="25dp"
        android:layout_height="25dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/guideline4"
        app:layout_constraintEnd_toStartOf="@id/guideline3"
        app:srcCompat="@drawable/ic_marker_cross" />

    <ImageView
        android:id="@+id/trackingPoint_3_1"
        android:layout_width="25dp"
        android:layout_height="25dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guideline3"
        app:layout_constraintBottom_toTopOf="@id/guideline4"
        app:srcCompat="@drawable/ic_marker_cross" />

    <ImageView
        android:id="@+id/trackingPoint_2_3"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_marginBottom="25dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/trackingPoint_1_4"
        app:layout_constraintStart_toEndOf="@+id/trackingPoint_1_3"
        app:srcCompat="@drawable/ic_marker_cross" />

    <ImageView
        android:id="@+id/trackingPoint_2_1"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_marginTop="25dp"
        app:layout_constraintEnd_toStartOf="@+id/trackingPoint_1_2"
        app:layout_constraintStart_toEndOf="@+id/trackingPoint_1_1"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_marker_cross" />

    <ImageView
        android:id="@+id/trackingPoint_2_2"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_marginEnd="25dp"
        app:layout_constraintBottom_toTopOf="@+id/trackingPoint_1_4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/trackingPoint_1_2"
        app:srcCompat="@drawable/ic_marker_cross" />

    <ImageView
        android:id="@+id/trackingPoint_2_4"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_marginStart="25dp"
        app:layout_constraintBottom_toTopOf="@+id/trackingPoint_1_3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/trackingPoint_1_1"
        app:srcCompat="@drawable/ic_marker_cross" />

    <ImageView
        android:id="@+id/trackingPoint_1_4"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_marginEnd="25dp"
        android:layout_marginBottom="25dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/ic_marker_cross" />

    <ImageView
        android:id="@+id/trackingPoint_1_3"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_marginStart="25dp"
        android:layout_marginBottom="25dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/ic_marker_cross" />

    <ImageView
        android:id="@+id/trackingPoint_1_5"
        android:layout_width="25dp"
        android:layout_height="25dp"
        app:layout_constraintBottom_toTopOf="@+id/trackingPoint_2_3"
        app:layout_constraintEnd_toStartOf="@+id/trackingPoint_2_2"
        app:layout_constraintStart_toEndOf="@+id/trackingPoint_2_4"
        app:layout_constraintTop_toBottomOf="@+id/trackingPoint_2_1"
        app:srcCompat="@drawable/ic_marker_cross" />

    <ImageView
        android:id="@+id/trackingPoint_1_2"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_marginTop="25dp"
        android:layout_marginEnd="25dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_marker_cross" />

    <ImageView
        android:id="@+id/trackingPoint_1_1"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_marginStart="25dp"
        android:layout_marginTop="25dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_marker_cross" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.5" />

</androidx.constraintlayout.widget.ConstraintLayout>