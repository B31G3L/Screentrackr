<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- Vorschau als Vollbild-Hintergrund -->
    <include
        layout="@layout/activity_trackingscreen"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Gradient Overlay für bessere Lesbarkeit -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/gradient_overlay"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Header / Logo - fix ganz oben, mit schönem Abstand -->
    <ImageView
        android:id="@+id/imageView"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="32dp"
        android:layout_marginHorizontal="24dp"
        android:contentDescription="@string/content_description_logo"
        android:scaleType="fitCenter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/inapplogo" />

    <!-- Start Button - fix ganz unten -->
    <Button
        android:id="@+id/button_start"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="24dp"
        android:backgroundTint="@color/primary"
        android:text="@string/button_text_start"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:textStyle="bold"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Einstellungen - scrollbar zwischen Header und Button -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/mainScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/button_start"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp">

            <!-- Einstellungen Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/settings_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#E6000000"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeColor="#33FFFFFF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Überschrift -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        android:gravity="center"
                        android:text="@string/settings_title"
                        android:textColor="@color/primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <!-- Farbeinstellungen -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:gravity="center"
                                android:text="@string/value_background_color"
                                android:textColor="@color/text_light"
                                android:textSize="14sp" />

                            <Button
                                android:id="@+id/buttonBackgroundColor"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:layout_marginEnd="8dp"
                                android:text="@string/button_background"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:gravity="center"
                                android:text="@string/value_marker_color"
                                android:textColor="@color/text_light"
                                android:textSize="14sp" />

                            <Button
                                android:id="@+id/buttonMarkerColor"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:layout_marginStart="8dp"
                                android:text="@string/button_marker"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Markerdichte -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/value_marker_density"
                            android:textColor="@color/text_light"
                            android:textSize="16sp" />

                        <Spinner
                            android:id="@+id/spinner_marker_density"
                            android:layout_width="120dp"
                            android:layout_height="48dp"
                            android:background="@drawable/spinner_background"
                            android:popupBackground="@color/background" />
                    </LinearLayout>

                    <!-- Markergröße -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/value_marker_size"
                            android:textColor="@color/text_light"
                            android:textSize="16sp" />

                        <Spinner
                            android:id="@+id/spinner_marker_size"
                            android:layout_width="120dp"
                            android:layout_height="48dp"
                            android:background="@drawable/spinner_background"
                            android:popupBackground="@color/background" />
                    </LinearLayout>

                    <!-- Markertyp -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/value_marker_type"
                            android:textColor="@color/text_light"
                            android:textSize="16sp" />

                        <Spinner
                            android:id="@+id/spinner_marker_type"
                            android:layout_width="120dp"
                            android:layout_height="48dp"
                            android:background="@drawable/spinner_background"
                            android:popupBackground="@color/background" />
                    </LinearLayout>

                    <!-- Eckmarker -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/value_edge_marker"
                            android:textColor="@color/text_light"
                            android:textSize="16sp" />

                        <Spinner
                            android:id="@+id/spinner_edge_marker"
                            android:layout_width="120dp"
                            android:layout_height="48dp"
                            android:background="@drawable/spinner_background"
                            android:popupBackground="@color/background" />
                    </LinearLayout>

                    <!-- Edge Marker Größe -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/value_edge_marker_size"
                            android:textColor="@color/text_light"
                            android:textSize="16sp" />

                        <Spinner
                            android:id="@+id/spinner_edge_marker_size"
                            android:layout_width="120dp"
                            android:layout_height="48dp"
                            android:background="@drawable/spinner_background"
                            android:popupBackground="@color/background" />
                    </LinearLayout>

                    <!-- Scroll-Marker -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/value_scroll_marker"
                            android:textColor="@color/text_light"
                            android:textSize="16sp" />

                        <Spinner
                            android:id="@+id/spinner_scroll_marker"
                            android:layout_width="120dp"
                            android:layout_height="48dp"
                            android:background="@drawable/spinner_background"
                            android:popupBackground="@color/background" />
                    </LinearLayout>

                    <!-- NEU: Custom Scroll-Marker Checkbox -->
                    <CheckBox
                        android:id="@+id/checkbox_custom_scroll_marker"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="@string/value_custom_scroll_marker"
                        android:textColor="@color/text_light"
                        android:textSize="16sp"
                        android:buttonTint="@color/primary" />

                    <!-- NEU: Scroll-Marker Typ (nur sichtbar wenn Checkbox aktiviert) -->
                    <LinearLayout
                        android:id="@+id/layout_scroll_marker_type"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/value_scroll_marker_type"
                            android:textColor="@color/text_light"
                            android:textSize="16sp" />

                        <Spinner
                            android:id="@+id/spinner_scroll_marker_type"
                            android:layout_width="120dp"
                            android:layout_height="48dp"
                            android:background="@drawable/spinner_background"
                            android:popupBackground="@color/background" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
